{
  "version": 1,
  "id": "unet-encoder-decoder",
  "title": "U-Net preserves semantics and spatial detail",
  "purpose": "Show the contracting path, bottleneck, expanding path, and same-scale skip connections.",
  "output": {
    "svg": "curriculum/beginner/06-segmentation-promptable-segmentation/assets/unet-encoder-decoder.svg",
    "medium": "documentation and notebook",
    "alt_text": "Encoder stages reduce resolution into a bottleneck, decoder stages restore it, and two skip connections carry same-scale spatial detail across the U shape."
  },
