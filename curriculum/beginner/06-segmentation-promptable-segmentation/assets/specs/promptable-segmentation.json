{
  "version": 1,
  "id": "promptable-segmentation",
  "title": "Promptable segmentation reuses one image embedding",
  "purpose": "Show the SAM-style image encoder, prompt encoder, mask decoder, candidate masks, and quality estimates.",
  "output": {
    "svg": "curriculum/beginner/06-segmentation-promptable-segmentation/assets/promptable-segmentation.svg",
    "medium": "documentation and notebook",
    "alt_text": "The image is encoded once into a reusable embedding. A point, box, or mask prompt is encoded separately. Both meet in a mask decoder that returns candidate masks and quality estimates."
  },
  "canvas": {
    "width": 1600,
    "height": 900,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#D7DEE8"
      }
    }
  },
