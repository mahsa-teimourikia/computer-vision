    "semantic_colors": {
      "input": {"fill": "#FFFFFF", "stroke": "#52606D"},
      "query": {"fill": "#E8F2FF", "stroke": "#2878C8"},
      "key": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "value": {"fill": "#EAF7EA", "stroke": "#3D9B55"},
      "score": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "mix": {"fill": "#E5F7F6", "stroke": "#16A3A5"}
    }
  },
  "groups": [
    {"id": "attention", "label": "ONE ATTENTION HEAD · BATCH DIMENSION OMITTED", "bounds": {"x": 50, "y": 100, "width": 1600, "height": 550}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
  "nodes": [
