    {"id": "q", "group": "attention", "label": "Queries Q", "subtitle": "XWQ · N × dₖ", "type": "query", "bounds": {"x": 340, "y": 155, "width": 170, "height": 100}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "k", "group": "attention", "label": "Keys K", "subtitle": "XWK · N × dₖ", "type": "key", "bounds": {"x": 340, "y": 310, "width": 170, "height": 100}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "v", "group": "attention", "label": "Values V", "subtitle": "XWV · N × dᵥ", "type": "value", "bounds": {"x": 340, "y": 465, "width": 170, "height": 100}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
