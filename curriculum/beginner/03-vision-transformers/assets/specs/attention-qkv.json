{
  "version": "1.0",
  "id": "attention-qkv",
  "title": "Scaled dot-product attention: match, normalize, and mix",
  "purpose": "Trace token embeddings through query, key, value, attention score, and output operations.",
  "output": {
    "svg": "curriculum/beginner/03-vision-transformers/assets/attention-qkv.svg",
    "medium": "documentation and notebook",
    "alt_text": "Token embeddings fan out into query, key, and value projections. Queries and keys form scaled pairwise scores, softmax normalizes each query row, and the weights mix values into output tokens."
  },
  "canvas": {"width": 1700, "height": 720, "margin": 50, "background": "#F7F9FC", "grid": 10},
