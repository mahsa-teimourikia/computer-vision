{
  "version": 1,
  "id": "contrastive-learning",
  "title": "Contrastive learning as view agreement",
  "purpose": "Show how two augmentations, a shared encoder, and a projection head create positive pairs for NT-Xent.",
  "output": {
    "svg": "curriculum/beginner/04-self-supervised-visual-representation-learning/assets/contrastive-learning.svg",
    "medium": "documentation and notebook",
    "alt_text": "One unlabeled image creates two augmented views. A shared encoder and projection head map both views to embeddings that form a positive pair, while other images in the batch provide negatives."
  },
  "canvas": {"width": 1500, "height": 760, "background": "#F7F9FC", "margin": 64, "grid": 8},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 48, "min_layer_gap": 80, "node_padding": {"x": 24, "y": 16}},
  "style": {
    "font_family": "Inter, Arial, sans-serif", "title_color": "#16324F",
    "semantic_colors": {
      "data": {"fill": "#E5F7F6", "stroke": "#16A3A5"},
      "service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"},
      "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "action": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "operations": {"fill": "#FFFFFF", "stroke": "#D7DEE8"}
    }
  },
  "groups": [
    {"id": "views", "label": "Create two semantic-preserving views", "bounds": {"x": 64, "y": 112, "width": 420, "height": 570}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "encoding", "label": "Shared representation path", "bounds": {"x": 548, "y": 112, "width": 540, "height": 570}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "objective", "label": "Batch objective", "bounds": {"x": 1152, "y": 112, "width": 284, "height": 570}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
  "nodes": [
    {"id": "image", "group": "views", "label": "Unlabeled image", "type": "data", "bounds": {"x": 176, "y": 190, "width": 200, "height": 86}, "ports": {"view_a": {"side": "bottom", "offset": 0.3}, "view_b": {"side": "bottom", "offset": 0.7}}},
    {"id": "view_a", "group": "views", "label": "View A", "subtitle": "crop · brightness · blur", "type": "service", "bounds": {"x": 128, "y": 330, "width": 220, "height": 112}, "ports": {"in": {"side": "top", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "view_b", "group": "views", "label": "View B", "subtitle": "independent transform", "type": "service", "bounds": {"x": 128, "y": 522, "width": 220, "height": 112}, "ports": {"in": {"side": "top", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "encoder_a", "group": "encoding", "label": "Encoder fθ", "subtitle": "representation h₁", "type": "agent", "bounds": {"x": 596, "y": 320, "width": 172, "height": 132}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "encoder_b", "group": "encoding", "label": "Encoder fθ", "subtitle": "shared weights · h₂", "type": "agent", "bounds": {"x": 596, "y": 524, "width": 172, "height": 108}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "project_a", "group": "encoding", "label": "Projection g", "subtitle": "z₁", "type": "action", "bounds": {"x": 856, "y": 320, "width": 172, "height": 132}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
    {"id": "project_b", "group": "encoding", "label": "Projection g", "subtitle": "z₂", "type": "action", "bounds": {"x": 856, "y": 524, "width": 172, "height": 108}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
