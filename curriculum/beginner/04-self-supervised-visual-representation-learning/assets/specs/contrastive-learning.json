    {"id": "encoder_project_b", "from": {"node": "encoder_b", "port": "out"}, "to": {"node": "project_b", "port": "in"}, "kind": "primary", "route": [[768, 578], [856, 578]]},
    {"id": "project_a_loss", "from": {"node": "project_a", "port": "out"}, "to": {"node": "ntxent", "port": "a"}, "kind": "primary", "route": [[1028, 386], [1120, 386], [1120, 443], [1204, 443]]},
    {"id": "project_b_loss", "from": {"node": "project_b", "port": "out"}, "to": {"node": "ntxent", "port": "b"}, "kind": "primary", "route": [[1028, 578], [1120, 578], [1120, 505], [1204, 505]]}
