      "service": {"fill": "#EAF1FF", "stroke": "#2F6BFF"},
      "agent": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "action": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "operations": {"fill": "#FFFFFF", "stroke": "#D7DEE8"}
    }
  },
  "groups": [
    {"id": "corruption", "label": "Construct the self-supervised target", "bounds": {"x": 64, "y": 112, "width": 620, "height": 470}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "model", "label": "Asymmetric encoder–decoder", "bounds": {"x": 748, "y": 112, "width": 708, "height": 470}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
