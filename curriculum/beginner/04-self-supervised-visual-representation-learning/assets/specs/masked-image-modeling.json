{
  "version": 1,
  "id": "masked-image-modeling",
  "title": "Masked image modeling with an asymmetric autoencoder",
  "purpose": "Explain the MAE path from image patches through a visible-token encoder and lightweight reconstruction decoder.",
  "output": {
    "svg": "curriculum/beginner/04-self-supervised-visual-representation-learning/assets/masked-image-modeling.svg",
    "medium": "documentation and notebook",
    "alt_text": "An image is patchified, most patches are masked, visible tokens enter the expensive encoder, mask tokens and encoded visible tokens enter a lightweight decoder, and loss is measured on missing patches."
  },
  "canvas": {"width": 1520, "height": 660, "background": "#F7F9FC", "margin": 64, "grid": 8},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 44, "min_layer_gap": 72, "node_padding": {"x": 22, "y": 16}},
