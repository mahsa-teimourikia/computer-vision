    {"id": "mask", "group": "corruption", "label": "Mask ~75%", "subtitle": "keep visible subset", "type": "action", "bounds": {"x": 522, "y": 256, "width": 128, "height": 128}, "ports": {"in": {"side": "left", "offset": 0.5}, "visible": {"side": "right", "offset": 0.35}, "targets": {"side": "bottom", "offset": 0.5}}},
    {"id": "encoder", "group": "model", "label": "Encoder", "subtitle": "visible tokens only\nexpensive path", "type": "agent", "bounds": {"x": 796, "y": 238, "width": 176, "height": 152}, "ports": {"in": {"side": "left", "offset": 0.5}, "out": {"side": "right", "offset": 0.5}}},
