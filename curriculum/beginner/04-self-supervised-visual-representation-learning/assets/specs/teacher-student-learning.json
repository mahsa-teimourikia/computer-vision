{
  "version": 1,
  "id": "teacher-student-learning",
  "title": "Teacher–student learning without labels",
  "purpose": "Explain online learning, stop-gradient targets, EMA updates, and DINO-style multi-view agreement.",
  "output": {
    "svg": "curriculum/beginner/04-self-supervised-visual-representation-learning/assets/teacher-student-learning.svg",
    "medium": "documentation and notebook",
    "alt_text": "Global and local crops enter a trainable student while global crops enter a stop-gradient teacher. Student and teacher distributions are matched, and an exponential moving average of student weights updates the teacher."
