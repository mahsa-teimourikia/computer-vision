    {"id": "signals", "label": "Learning signals", "bounds": {"x": 1142, "y": 112, "width": 274, "height": 570}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
  "nodes": [
    {"id": "global_crop", "group": "views", "label": "Global crop", "subtitle": "teacher + student", "type": "data", "bounds": {"x": 112, "y": 244, "width": 222, "height": 116}, "ports": {"student": {"side": "right", "offset": 0.35}, "teacher": {"side": "right", "offset": 0.75}}},
    {"id": "local_crop", "group": "views", "label": "Local crops", "subtitle": "student only", "type": "data", "bounds": {"x": 112, "y": 466, "width": 222, "height": 116}, "ports": {"out": {"side": "right", "offset": 0.5}}},
