      "action": {"fill": "#FFF1DF", "stroke": "#F59E42"},
      "operations": {"fill": "#FFFFFF", "stroke": "#D7DEE8"}
    }
  },
  "groups": [
    {"id": "views", "label": "Views from one image", "bounds": {"x": 64, "y": 112, "width": 330, "height": 570}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
