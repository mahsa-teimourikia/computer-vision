  "canvas": {"width": 1480, "height": 760, "background": "#F7F9FC", "margin": 64, "grid": 8},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 48, "min_layer_gap": 80, "node_padding": {"x": 24, "y": 16}},
