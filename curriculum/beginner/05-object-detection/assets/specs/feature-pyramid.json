{
  "version": 1,
  "id": "feature-pyramid",
  "title": "Feature pyramids combine detail with semantics",
  "purpose": "Explain top-down and lateral multi-scale fusion for detection.",
  "output": {
    "svg": "curriculum/beginner/05-object-detection/assets/feature-pyramid.svg",
    "medium": "documentation and notebook",
    "alt_text": "Four backbone stages become progressively lower resolution and more semantic, while lateral connections and top-down fusion create pyramid outputs P2 through P5."
  },
  "canvas": {
    "width": 1600,
    "height": 900,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#D7DEE8"
      }
    }
  },
  "groups": [
    {
      "id": "backbone",
      "label": "Backbone features",
      "bounds": {
        "x": 64,
        "y": 120,
        "width": 650,
        "height": 680
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    },
    {
      "id": "pyramid",
      "label": "Fused pyramid",
      "bounds": {
        "x": 886,
        "y": 120,
        "width": 650,
        "height": 680
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "c2",
      "group": "backbone",
      "label": "C2",
      "subtitle": "high resolution\nlower semantics",
      "type": "data",
      "bounds": {
        "x": 130,
        "y": 210,
        "width": 220,
        "height": 110
      },
      "ports": {
        "out": {
          "side": "right",
