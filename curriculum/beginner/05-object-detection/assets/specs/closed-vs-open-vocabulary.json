{
  "version": 1,
  "id": "closed-vs-open-vocabulary",
  "title": "From fixed labels to text-conditioned detection",
  "purpose": "Preview the shift from closed-set detection to open-vocabulary grounding.",
  "output": {
    "svg": "curriculum/beginner/05-object-detection/assets/closed-vs-open-vocabulary.svg",
    "medium": "documentation and notebook",
    "alt_text": "Closed-set detection maps image features to a fixed trained label head, while open-vocabulary detection aligns image regions with text prompts and requires prompt, calibration, and unknown-category evaluation."
  },
  "canvas": {
    "width": 1600,
    "height": 900,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
