{
  "version": "1.0",
  "id": "vision-task-taxonomy",
  "title": "Vision tasks differ by the output contract they must produce",
  "purpose": "Organize common tasks by perception, geometry, and semantic interaction outputs.",
  "output": {
    "svg": "curriculum/beginner/01-modern-computer-vision-foundations/assets/vision-task-taxonomy.svg",
