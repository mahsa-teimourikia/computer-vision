    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "error": {
        "fill": "#FFF0F3",
        "stroke": "#D64562"
      },
      "cause": {
        "fill": "#FFF7E6",
        "stroke": "#D9822B"
      },
      "test": {
        "fill": "#EAF4FF",
        "stroke": "#2F80ED"
      },
      "action": {
        "fill": "#EAFBF3",
        "stroke": "#219653"
      }
    }
  },
  "groups": [
    {
      "id": "observe",
