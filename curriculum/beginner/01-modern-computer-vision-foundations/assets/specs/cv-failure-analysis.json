{
  "version": "1.0",
  "id": "cv-failure-analysis",
  "title": "Failure analysis traces an error back to the system layer that created it",
  "purpose": "Provide a repeatable taxonomy for diagnosing computer vision errors.",
  "output": {
    "svg": "curriculum/beginner/01-modern-computer-vision-foundations/assets/cv-failure-analysis.svg",
    "alt_text": "An observed error is traced through data, representation, shift, and decision-policy failure buckets before a targeted mitigation and retest."
  },
  "canvas": {
    "width": 1200,
    "height": 740,
    "margin": 50,
    "background": "#F7FAFC"
  },
  "layout": {
    "type": "diagnostic-tree",
    "direction": "top-to-bottom"
  },
