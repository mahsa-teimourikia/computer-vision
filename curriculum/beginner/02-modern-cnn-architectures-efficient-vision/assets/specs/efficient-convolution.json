      "grouped": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "depthwise": {"fill": "#E5F7F6", "stroke": "#16A3A5"},
      "pointwise": {"fill": "#FFF1DF", "stroke": "#F59E42"}
