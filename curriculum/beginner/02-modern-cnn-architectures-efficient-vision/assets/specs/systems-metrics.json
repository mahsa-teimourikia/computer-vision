{
  "version": "1.0",
  "id": "systems-metrics",
  "title": "No single efficiency metric describes deployment behavior",
  "purpose": "Separate static, analytic, and measured systems metrics.",
  "output": {
    "svg": "curriculum/beginner/02-modern-cnn-architectures-efficient-vision/assets/systems-metrics.svg",
    "medium": "documentation and notebook",
    "alt_text": "Three groups distinguish static artifact metrics such as parameter count and model size, analytic workload estimates such as MACs and activation traffic, and measured runtime metrics such as latency distribution, throughput, and peak memory."
  },
  "canvas": {"width": 1500, "height": 820, "margin": 50, "background": "#F7F9FC", "grid": 10},
  "layout": {"primary_flow": "left-to-right", "min_node_gap": 55, "min_layer_gap": 80, "node_padding": {"x": 22, "y": 16}},
  "style": {
    "font_family": "Inter, Arial, sans-serif", "title_color": "#16324F",
    "semantic_colors": {
      "static": {"fill": "#EAF1FF", "stroke": "#2F6BFF"},
      "analytic": {"fill": "#F0EEFF", "stroke": "#7667E8"},
      "measured": {"fill": "#E5F7F6", "stroke": "#16A3A5"}
    }
  },
  "groups": [
    {"id": "static_g", "label": "STATIC ARTIFACT · MODEL DEFINITION", "bounds": {"x": 50, "y": 120, "width": 420, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "analytic_g", "label": "ANALYTIC ESTIMATE · FIXED SHAPE", "bounds": {"x": 540, "y": 120, "width": 420, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"},
    {"id": "measured_g", "label": "MEASURED RUNTIME · TARGET SYSTEM", "bounds": {"x": 1030, "y": 120, "width": 420, "height": 620}, "fill": "#FFFFFF", "stroke": "#D7DEE8"}
  ],
  "nodes": [
    {"id": "params", "group": "static_g", "label": "Parameter count", "subtitle": "learned scalar count\nnot activation memory", "type": "static", "bounds": {"x": 100, "y": 220, "width": 320, "height": 130}, "ports": {}},
    {"id": "model_size", "group": "static_g", "label": "Model file size", "subtitle": "serialization + precision\nnot elapsed time", "type": "static", "bounds": {"x": 100, "y": 450, "width": 320, "height": 130}, "ports": {}},
    {"id": "macs", "group": "analytic_g", "label": "Approximate MACs", "subtitle": "arithmetic workload\nnot kernel efficiency", "type": "analytic", "bounds": {"x": 590, "y": 220, "width": 320, "height": 130}, "ports": {}},
    {"id": "activations", "group": "analytic_g", "label": "Activation traffic", "subtitle": "intermediate tensors\nshape-dependent estimate", "type": "analytic", "bounds": {"x": 590, "y": 450, "width": 320, "height": 130}, "ports": {}},
    {"id": "latency", "group": "measured_g", "label": "Latency distribution", "subtitle": "median · IQR · p90 · p95\nbatch 1 and target runtime", "type": "measured", "bounds": {"x": 1080, "y": 185, "width": 320, "height": 130}, "ports": {}},
    {"id": "throughput", "group": "measured_g", "label": "Throughput", "subtitle": "items per second\nunder a stated batch/load", "type": "measured", "bounds": {"x": 1080, "y": 365, "width": 320, "height": 130}, "ports": {}},
    {"id": "peak_memory", "group": "measured_g", "label": "Peak device memory", "subtitle": "allocator high-water mark\nbackend-specific", "type": "measured", "bounds": {"x": 1080, "y": 545, "width": 320, "height": 130}, "ports": {}}
  ],
  "edges": [],
  "validation": {"no_overlaps": true, "route_around_nodes": true, "min_text_padding": 16, "min_connector_clearance": 12, "verify_port_attachment": true, "verify_contrast": true}
}
