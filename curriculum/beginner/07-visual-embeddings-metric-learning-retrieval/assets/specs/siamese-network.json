      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
