{
  "version": 1,
  "id": "siamese-network",
  "title": "Siamese shared-weight encoding",
  "purpose": "Show that Siamese describes shared parameters rather than one particular loss.",
  "output": {
    "svg": "curriculum/beginner/07-visual-embeddings-metric-learning-retrieval/assets/siamese-network.svg",
    "medium": "documentation and notebook",
    "alt_text": "Two images pass through encoder branches tied by shared weights, then their embeddings enter a similarity or metric-learning loss."
  },
  "canvas": {
    "width": 1600,
    "height": 760,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 72,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
