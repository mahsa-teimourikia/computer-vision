{
  "version": 1,
  "id": "embedding-space",
  "title": "From images to task-defined neighbours",
  "purpose": "Explain that an encoder creates vectors but the product contract defines which neighbours are useful.",
  "output": {
    "svg": "curriculum/beginner/07-visual-embeddings-metric-learning-retrieval/assets/embedding-space.svg",
    "medium": "documentation and notebook",
    "alt_text": "A left-to-right flow from industrial images through a visual encoder and embedding vectors to neighbourhoods labeled by component, defect, or duplicate relevance."
  },
  "canvas": {
    "width": 1600,
    "height": 720,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 72,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#D7DEE8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Visual retrieval system",
      "bounds": {
        "x": 64,
        "y": 100,
        "width": 1472,
        "height": 556
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
