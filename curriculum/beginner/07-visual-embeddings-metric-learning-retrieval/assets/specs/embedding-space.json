        "x": 120,
        "y": 290,
        "width": 230,
        "height": 130
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      },
      "subtitle": "products \u00b7 defects \u00b7 crops"
    },
    {
      "id": "encoder",
      "group": "system",
