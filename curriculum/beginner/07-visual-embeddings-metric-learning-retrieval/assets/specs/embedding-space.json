      "bounds": {
        "x": 450,
        "y": 290,
        "width": 230,
        "height": 130
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      },
      "subtitle": "f\u03b8(x)"
    },
    {
      "id": "vectors",
      "group": "system",
      "label": "Embedding space",
      "type": "service",
      "bounds": {
        "x": 780,
        "y": 290,
        "width": 230,
        "height": 130
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      },
      "subtitle": "z \u2208 \u211d\u1d48"
    },
    {
      "id": "neighbors",
      "group": "system",
