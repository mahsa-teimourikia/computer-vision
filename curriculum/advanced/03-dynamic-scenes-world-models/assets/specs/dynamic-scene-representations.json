      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        },
        "right": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "gaussians",
      "group": "system",
      "label": "DYNAMIC\nGAUSSIANS",
      "subtitle": "persistent primitives",
      "type": "service",
      "bounds": {
        "x": 965,
        "y": 260,
        "width": 240,
        "height": 160
      },
      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        },
        "right": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "objects",
      "group": "system",
      "label": "OBJECT STATE",
      "subtitle": "identity + attributes",
