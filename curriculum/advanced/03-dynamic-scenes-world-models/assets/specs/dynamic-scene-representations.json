  "validation": {
    "status": "validated",
    "checked": [
      "unique_ids",
      "port_attachment",
      "group_containment",
      "no_overlaps",
      "20px_clearance"
    ],
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
