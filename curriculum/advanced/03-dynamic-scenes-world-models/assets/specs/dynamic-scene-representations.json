      "route": [
        [
          920,
          340
        ],
        [
          965,
          340
        ]
      ]
    },
    {
      "id": "gaussians_objects",
      "from": {
        "node": "gaussians",
        "port": "right"
      },
      "to": {
        "node": "objects",
        "port": "left"
      },
      "kind": "secondary",
      "route": [
        [
          1205,
          340
        ],
        [
          1250,
          340
        ]
      ]
    }
