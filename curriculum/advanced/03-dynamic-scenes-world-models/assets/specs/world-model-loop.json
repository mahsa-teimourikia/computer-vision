{
  "version": 1,
  "id": "world-model-loop",
  "title": "World model loop",
  "purpose": "Separate sensing, persistent state, action-conditioned transition, and decoded evidence.",
  "output": {
    "svg": "curriculum/advanced/03-dynamic-scenes-world-models/assets/world-model-loop.svg",
    "medium": "documentation and notebook",
    "alt_text": "An observation is encoded into persistent state; a structured action conditions dynamics; future state is decoded into future observations."
  },
  "canvas": {
    "width": 1600,
    "height": 760,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 20,
      "y": 14
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
