{
  "version": 1,
  "id": "world-model-taxonomy",
  "title": "World model taxonomy",
  "purpose": "Organize world models by representation and use rather than leaderboard.",
  "output": {
    "svg": "curriculum/advanced/03-dynamic-scenes-world-models/assets/world-model-taxonomy.svg",
    "medium": "documentation and notebook",
    "alt_text": "Five families compare latent dynamics, pixel and video prediction, interactive worlds, explicit 4D state, and object-centric dynamics."
  },
  "canvas": {
    "width": 1600,
    "height": 760,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 20,
      "y": 14
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#D7DEE8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Choose the representation for the task-relevant state and query",
      "bounds": {
        "x": 64,
        "y": 105,
        "width": 1472,
        "height": 555
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "latent",
      "group": "system",
      "label": "LATENT DYNAMICS",
      "subtitle": "Dreamer-style",
      "type": "agent",
      "bounds": {
        "x": 110,
        "y": 250,
        "width": 240,
        "height": 170
      },
      "ports": {}
    },
    {
      "id": "video",
      "group": "system",
      "label": "PIXEL / VIDEO",
      "subtitle": "generative futures",
      "type": "data",
      "bounds": {
        "x": 395,
        "y": 250,
        "width": 240,
        "height": 170
      },
      "ports": {}
    },
    {
      "id": "interactive",
      "group": "system",
      "label": "INTERACTIVE WORLDS",
      "subtitle": "Genie-style",
      "type": "action",
      "bounds": {
        "x": 680,
        "y": 250,
        "width": 240,
        "height": 170
      },
      "ports": {}
    },
    {
      "id": "explicit",
      "group": "system",
      "label": "EXPLICIT 4D",
      "subtitle": "fields · Gaussians",
      "type": "service",
      "bounds": {
        "x": 965,
        "y": 250,
        "width": 240,
        "height": 170
      },
      "ports": {}
    },
    {
      "id": "objects",
      "group": "system",
      "label": "OBJECT-CENTRIC",
      "subtitle": "persistent entities",
      "type": "operations",
      "bounds": {
        "x": 1250,
        "y": 250,
        "width": 240,
        "height": 170
      },
      "ports": {}
    }
  ],
  "edges": [],
  "validation": {
    "status": "validated",
    "checked": [
      "unique_ids",
      "port_attachment",
      "group_containment",
      "no_overlaps",
      "20px_clearance"
    ],
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  },
  "source": {
    "renderer": "scripts/render_course_diagrams.py",
    "deterministic": true
  }
}
