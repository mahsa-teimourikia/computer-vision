{
  "version": 1,
  "id": "observation-vs-state",
  "title": "Observation is not world state",
  "purpose": "Show visible evidence and hidden predictive state.",
  "output": {
    "svg": "curriculum/advanced/03-dynamic-scenes-world-models/assets/observation-vs-state.svg",
    "medium": "documentation and notebook",
    "alt_text": "A visible frame shows a cart while persistent state also retains velocity, occluded identity, friction context, and actuator delay."
  },
  "canvas": {
    "width": 1600,
    "height": 760,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 20,
      "y": 14
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#D7DEE8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "A single frame can hide variables required for prediction",
      "bounds": {
        "x": 64,
        "y": 105,
        "width": 1472,
        "height": 555
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "visible",
      "group": "system",
      "label": "VISIBLE OBSERVATION",
      "subtitle": "pixels · current detections",
      "type": "data",
      "bounds": {
        "x": 150,
        "y": 250,
        "width": 380,
        "height": 180
      },
      "ports": {
        "right": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "state",
      "group": "system",
      "label": "PERSISTENT WORLD STATE",
      "subtitle": "visible pose · velocity\noccluded identity · uncertainty",
      "type": "service",
      "bounds": {
        "x": 650,
        "y": 230,
        "width": 380,
        "height": 220
      },
      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        },
        "right": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "future",
      "group": "system",
      "label": "TASK-RELEVANT FUTURE",
      "subtitle": "position · event · outcome",
      "type": "agent",
      "bounds": {
        "x": 1150,
        "y": 250,
        "width": 300,
        "height": 180
      },
      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        }
      }
    }
  ],
  "edges": [
    {
      "id": "observe_to_state",
      "from": {
        "node": "visible",
        "port": "right"
      },
      "to": {
        "node": "state",
        "port": "left"
      },
      "kind": "primary",
      "label": "estimate + memory",
      "label_at": [
        590,
        330
      ],
      "route": [
        [
          530,
          340
        ],
        [
          650,
          340
        ]
      ]
    },
    {
      "id": "state_to_future",
      "from": {
        "node": "state",
        "port": "right"
      },
      "to": {
        "node": "future",
        "port": "left"
      },
      "kind": "primary",
      "label": "predict",
      "label_at": [
        1090,
        330
      ],
      "route": [
        [
          1030,
          340
        ],
        [
          1150,
          340
        ]
      ]
    }
  ],
  "validation": {
    "status": "validated",
    "checked": [
      "unique_ids",
      "port_attachment",
      "group_containment",
      "no_overlaps",
      "20px_clearance"
    ],
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  },
  "source": {
    "renderer": "scripts/render_course_diagrams.py",
    "deterministic": true
  }
}
