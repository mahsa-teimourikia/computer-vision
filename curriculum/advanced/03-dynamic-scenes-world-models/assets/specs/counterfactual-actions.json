{
  "version": 1,
  "id": "counterfactual-actions",
  "title": "Counterfactual action test",
  "purpose": "Hold initial state fixed and vary structured actions.",
  "output": {
    "svg": "curriculum/advanced/03-dynamic-scenes-world-models/assets/counterfactual-actions.svg",
    "medium": "documentation and notebook",
    "alt_text": "The same initial state branches to a left displacement, stopped state, and right displacement under three actions."
  },
  "canvas": {
    "width": 1600,
    "height": 760,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 80,
    "node_padding": {
      "x": 20,
      "y": 14
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#D7DEE8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Action responsiveness requires both relevant change and irrelevant invariance",
      "bounds": {
        "x": 64,
        "y": 105,
        "width": 1472,
        "height": 555
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "initial",
      "group": "system",
      "label": "SAME INITIAL STATE",
      "subtitle": "cart x=0 · v=0",
      "type": "data",
      "bounds": {
        "x": 130,
        "y": 270,
        "width": 300,
        "height": 170
      },
      "ports": {
        "right": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "left",
      "group": "system",
      "label": "MOVE LEFT",
      "subtitle": "future Δx < 0",
      "type": "service",
      "bounds": {
        "x": 1080,
        "y": 145,
        "width": 300,
        "height": 130
      },
      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        }
      }
    },
    {
      "id": "stop",
      "group": "system",
      "label": "STOP",
      "subtitle": "future velocity = 0",
      "type": "operations",
      "bounds": {
        "x": 1080,
        "y": 315,
        "width": 300,
        "height": 130
      },
      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        }
      }
    },
    {
      "id": "right",
      "group": "system",
      "label": "MOVE RIGHT",
      "subtitle": "future Δx > 0",
      "type": "action",
      "bounds": {
        "x": 1080,
        "y": 485,
        "width": 300,
        "height": 130
      },
      "ports": {
        "left": {
          "side": "left",
          "offset": 0.5
        }
      }
    }
  ],
  "edges": [
    {
      "id": "to_left",
      "from": {
        "node": "initial",
        "port": "right"
      },
      "to": {
        "node": "left",
        "port": "left"
      },
      "kind": "primary",
      "label": "left",
      "label_at": [
        760,
        210
      ],
      "route": [
        [
          430,
          355
        ],
        [
          760,
          355
        ],
        [
          760,
          210
        ],
        [
          1080,
          210
        ]
      ]
    },
    {
      "id": "to_stop",
      "from": {
        "node": "initial",
        "port": "right"
      },
      "to": {
        "node": "stop",
        "port": "left"
      },
      "kind": "primary",
      "label": "stop",
      "label_at": [
        760,
        370
      ],
      "route": [
        [
          430,
          355
        ],
        [
          760,
          355
        ],
        [
          760,
          380
        ],
        [
          1080,
          380
        ]
      ]
    },
    {
      "id": "to_right",
      "from": {
        "node": "initial",
        "port": "right"
      },
      "to": {
        "node": "right",
        "port": "left"
      },
      "kind": "primary",
      "label": "right",
      "label_at": [
        760,
        550
      ],
      "route": [
        [
          430,
          355
        ],
        [
          760,
          355
        ],
        [
          760,
          550
        ],
        [
          1080,
          550
        ]
      ]
    }
  ],
  "validation": {
    "status": "validated",
    "checked": [
      "unique_ids",
      "port_attachment",
      "group_containment",
      "no_overlaps",
      "20px_clearance"
    ],
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  },
  "source": {
    "renderer": "scripts/render_course_diagrams.py",
    "deterministic": true
  }
}
