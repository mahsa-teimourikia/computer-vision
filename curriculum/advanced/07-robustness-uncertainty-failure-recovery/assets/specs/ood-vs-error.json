{
  "version": 1,
  "id": "ood-vs-error",
  "title": "OOD detection is not error detection",
  "purpose": "Show the four-way relationship between support and correctness.",
  "output": {
    "svg": "curriculum/advanced/07-robustness-uncertainty-failure-recovery/assets/ood-vs-error.svg",
    "medium": "documentation and notebook",
    "alt_text": "Four quadrants show that in-distribution predictions can be wrong and out-of-distribution predictions can be correct."
  },
  "canvas": {
    "width": 1400,
    "height": 520,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 48,
    "min_layer_gap": 72,
    "node_padding": {
      "x": 20,
      "y": 14
    }
  },
  "style": {
