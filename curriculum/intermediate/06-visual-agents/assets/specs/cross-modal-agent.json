  "output": {"svg": "curriculum/intermediate/06-visual-agents/assets/cross-modal-agent.svg", "medium": "documentation and notebook", "alt_text": "Inspection image, maintenance manual, and recent video each feed an authorized tool and verifier before a deterministic manual-review decision."},
