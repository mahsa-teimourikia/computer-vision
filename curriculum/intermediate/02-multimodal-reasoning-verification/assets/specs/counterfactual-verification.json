{
  "version": 1,
  "id": "counterfactual-verification",
  "title": "Perturb one fact and test the rule",
  "purpose": "Contrast relevant sensitivity with irrelevant invariance.",
  "output": {
    "svg": "curriculum/intermediate/02-multimodal-reasoning-verification/assets/counterfactual-verification.svg",
    "medium": "documentation and notebook",
    "alt_text": "A baseline scene branches to a relevant bolt-count change that should flip the decision and an irrelevant color change that should leave it unchanged."
  },
  "canvas": {
    "width": 1780,
    "height": 800,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 40,
    "min_layer_gap": 64,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#8A97A8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Observable reasoning contract",
      "bounds": {
        "x": 64,
        "y": 100,
        "width": 1652,
        "height": 636
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "base",
      "group": "system",
      "label": "Baseline scene",
      "subtitle": "scratch \u00b7 left \u00b7 2 bolts \u00b7 red",
      "type": "data",
      "bounds": {
        "x": 120,
        "y": 310,
        "width": 370,
        "height": 120
      },
      "ports": {
        "r": {
          "side": "right",
          "offset": 0.25
        },
        "i": {
          "side": "right",
          "offset": 0.75
        }
      }
    },
    {
      "id": "relevant",
      "group": "system",
      "label": "Relevant change",
      "subtitle": "2 bolts \u2192 4 bolts",
      "type": "action",
      "bounds": {
        "x": 670,
        "y": 180,
        "width": 360,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "irrelevant",
      "group": "system",
      "label": "Irrelevant change",
      "subtitle": "red \u2192 blue",
      "type": "action",
      "bounds": {
        "x": 670,
        "y": 470,
        "width": 360,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "flip",
      "group": "system",
      "label": "Expected: flip",
      "subtitle": "observed decision changes",
      "type": "agent",
      "bounds": {
        "x": 1240,
        "y": 180,
        "width": 360,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "stable",
      "group": "system",
      "label": "Expected: invariant",
      "subtitle": "observed decision unchanged",
      "type": "agent",
      "bounds": {
        "x": 1240,
        "y": 470,
        "width": 360,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "r1",
      "from": {
        "node": "base",
        "port": "r"
      },
      "to": {
        "node": "relevant",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          490,
          340
        ],
        [
          570,
          340
        ],
        [
          570,
          240
        ],
        [
          670,
          240
        ]
      ]
    },
    {
      "id": "i1",
      "from": {
        "node": "base",
        "port": "i"
      },
      "to": {
        "node": "irrelevant",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          490,
          400
        ],
        [
          570,
          400
        ],
        [
          570,
          530
        ],
        [
          670,
          530
        ]
      ]
    },
    {
      "id": "r2",
      "from": {
        "node": "relevant",
        "port": "out"
      },
      "to": {
        "node": "flip",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          1030,
          240
        ],
        [
          1240,
          240
        ]
      ]
    },
    {
      "id": "i2",
      "from": {
        "node": "irrelevant",
        "port": "out"
      },
      "to": {
        "node": "stable",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          1030,
          530
        ],
        [
          1240,
          530
        ]
      ]
    }
  ],
  "validation": {
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  }
}
