{
  "version": 1,
  "id": "deterministic-tool-boundary",
  "title": "Use exact tools after semantic extraction",
  "purpose": "Separate perception uncertainty from deterministic execution and record every call.",
  "output": {
    "svg": "curriculum/intermediate/02-multimodal-reasoning-verification/assets/deterministic-tool-boundary.svg",
    "medium": "documentation and notebook",
    "alt_text": "A versioned perception adapter produces structured observations for geometry, count, and arithmetic tools; all tools write versioned input and output events."
  },
  "canvas": {
    "width": 1800,
    "height": 820,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 40,
    "min_layer_gap": 64,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
