{
  "version": 1,
  "id": "checked-reasoning-pipeline",
  "title": "From visual question to checked conclusion",
  "purpose": "Show the public artifacts of a bounded multimodal reasoning pipeline without presenting private chain-of-thought.",
  "output": {
    "svg": "curriculum/intermediate/02-multimodal-reasoning-verification/assets/checked-reasoning-pipeline.svg",
    "medium": "documentation and notebook",
    "alt_text": "A six-stage flow moves from bounded question to task plan, bound evidence, deterministic tool results, checked claims, and an answer or review-required conclusion."
  },
  "canvas": {
    "width": 2040,
    "height": 760,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 40,
    "min_layer_gap": 64,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#8A97A8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Observable reasoning contract",
      "bounds": {
        "x": 64,
        "y": 100,
        "width": 1912,
        "height": 596
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "question",
      "group": "system",
      "label": "Bounded question",
      "subtitle": "scope \u00b7 rule \u00b7 output",
      "type": "service",
      "bounds": {
        "x": 100,
        "y": 300,
        "width": 260,
        "height": 104
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "plan",
      "group": "system",
      "label": "Task plan",
      "subtitle": "required facts \u00b7 DAG",
      "type": "agent",
      "bounds": {
        "x": 410,
        "y": 300,
        "width": 260,
        "height": 104
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "evidence",
      "group": "system",
