{
  "version": 1,
  "id": "multi-image-binding",
  "title": "Keep every fact attached to its source image",
  "purpose": "Show before and after verification before change reasoning.",
  "output": {
    "svg": "curriculum/intermediate/02-multimodal-reasoning-verification/assets/multi-image-binding.svg",
    "medium": "documentation and notebook",
    "alt_text": "Before and after images each produce source-bound facts that are independently verified, compared, and converted into a safer, not safer, or review conclusion."
  },
  "canvas": {
    "width": 2180,
    "height": 820,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 40,
    "min_layer_gap": 64,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#8A97A8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Observable reasoning contract",
      "bounds": {
        "x": 64,
        "y": 100,
        "width": 2052,
        "height": 656
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "before",
      "group": "system",
      "label": "Image A \u00b7 before",
      "subtitle": "facts carry image_id=before",
      "type": "data",
      "bounds": {
        "x": 120,
        "y": 200,
        "width": 390,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "after",
      "group": "system",
      "label": "Image B \u00b7 after",
      "subtitle": "facts carry image_id=after",
      "type": "data",
      "bounds": {
        "x": 120,
        "y": 500,
        "width": 390,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "verify_before",
      "group": "system",
      "label": "Verify facts A",
      "subtitle": "scratch \u00b7 side \u00b7 count",
      "type": "action",
      "bounds": {
        "x": 680,
        "y": 200,
        "width": 350,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "verify_after",
      "group": "system",
      "label": "Verify facts B",
      "subtitle": "scratch \u00b7 side \u00b7 count",
      "type": "action",
      "bounds": {
        "x": 680,
        "y": 500,
        "width": 350,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "compare",
      "group": "system",
      "label": "Checked comparison",
      "subtitle": "visual vs decision change",
      "type": "operations",
      "bounds": {
        "x": 1210,
        "y": 350,
        "width": 380,
        "height": 120
      },
      "ports": {
        "a": {
          "side": "left",
          "offset": 0.25
        },
        "b": {
          "side": "left",
          "offset": 0.75
        },
        "out": {
          "side": "right"
        }
      }
    },
    {
      "id": "result",
      "group": "system",
      "label": "Change conclusion",
      "subtitle": "safer \u00b7 not safer \u00b7 review",
      "type": "agent",
      "bounds": {
        "x": 1720,
        "y": 350,
        "width": 360,
        "height": 120
      },
      "ports": {
        "in": {
          "side": "left"
        },
        "out": {
          "side": "right"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "b1",
      "from": {
        "node": "before",
        "port": "out"
      },
      "to": {
        "node": "verify_before",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          510,
