        ],
        [
          680,
          260
        ]
      ]
    },
    {
      "id": "a1",
      "from": {
        "node": "after",
        "port": "out"
      },
      "to": {
        "node": "verify_after",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          510,
          560
        ],
        [
          680,
          560
        ]
      ]
    },
    {
      "id": "b2",
      "from": {
        "node": "verify_before",
        "port": "out"
      },
      "to": {
        "node": "compare",
        "port": "a"
      },
      "kind": "primary",
      "route": [
        [
          1030,
          260
        ],
        [
          1120,
          260
        ],
        [
          1120,
          380
        ],
        [
          1210,
          380
        ]
      ]
    },
    {
      "id": "a2",
      "from": {
        "node": "verify_after",
        "port": "out"
      },
      "to": {
        "node": "compare",
        "port": "b"
      },
      "kind": "primary",
      "route": [
        [
          1030,
          560
        ],
        [
          1120,
          560
        ],
        [
          1120,
          440
        ],
        [
          1210,
          440
        ]
      ]
    },
    {
      "id": "c",
      "from": {
        "node": "compare",
        "port": "out"
      },
      "to": {
        "node": "result",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          1590,
          410
        ],
        [
          1720,
          410
        ]
      ]
    }
  ],
  "validation": {
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  }
}
