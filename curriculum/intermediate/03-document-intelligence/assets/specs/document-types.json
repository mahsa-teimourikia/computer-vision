{
  "version": 1,
  "id": "document-types",
  "title": "Route document types before OCR",
  "purpose": "Compare the first processing decision for four input kinds.",
  "output": {
    "svg": "curriculum/intermediate/03-document-intelligence/assets/document-types.svg",
    "medium": "documentation and notebook",
    "alt_text": "Four document types: digital PDF, scanned PDF, hybrid PDF, and raster image, each requiring a different inspection path."
  },
  "canvas": {
    "width": 1268,
    "height": 650,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 40,
    "min_layer_gap": 64,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#8A97A8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "Route document types before OCR",
      "bounds": {
        "x": 64,
        "y": 100,
        "width": 1140,
        "height": 480
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "digital",
      "group": "system",
      "label": "Digital PDF\nembedded text",
      "type": "service",
      "bounds": {
        "x": 100,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "scanned",
      "group": "system",
      "label": "Scanned PDF\npage images",
      "type": "data",
      "bounds": {
        "x": 360,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "hybrid",
      "group": "system",
      "label": "Hybrid PDF\ntext + images",
      "type": "agent",
      "bounds": {
        "x": 620,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "raster",
      "group": "system",
      "label": "Raster image\nJPEG / PNG / TIFF",
      "type": "operations",
      "bounds": {
        "x": 880,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    }
  ],
  "edges": [],
  "validation": {
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  }
}