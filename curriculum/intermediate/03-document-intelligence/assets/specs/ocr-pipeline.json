{
  "version": 1,
  "id": "ocr-pipeline",
  "title": "OCR is localization plus recognition",
  "purpose": "Separate text detection from text recognition and structured output.",
  "output": {
    "svg": "curriculum/intermediate/03-document-intelligence/assets/ocr-pipeline.svg",
    "medium": "documentation and notebook",
    "alt_text": "A page image passes through text detection, text regions, recognition, and an output that retains text with boxes."
  },
  "canvas": {
    "width": 1528,
    "height": 650,
    "background": "#F7F9FC",
    "margin": 64,
    "grid": 8
  },
  "layout": {
    "primary_flow": "left-to-right",
    "min_node_gap": 40,
    "min_layer_gap": 64,
    "node_padding": {
      "x": 24,
      "y": 16
    }
  },
  "style": {
    "font_family": "Inter, Arial, sans-serif",
    "title_color": "#16324F",
    "semantic_colors": {
      "service": {
        "fill": "#EAF1FF",
        "stroke": "#2F6BFF"
      },
      "agent": {
        "fill": "#F0EEFF",
        "stroke": "#7667E8"
      },
      "data": {
        "fill": "#E5F7F6",
        "stroke": "#16A3A5"
      },
      "action": {
        "fill": "#FFF1DF",
        "stroke": "#F59E42"
      },
      "operations": {
        "fill": "#FFFFFF",
        "stroke": "#8A97A8"
      }
    }
  },
  "groups": [
    {
      "id": "system",
      "label": "OCR is localization plus recognition",
      "bounds": {
        "x": 64,
        "y": 100,
        "width": 1400,
        "height": 480
      },
      "fill": "#FFFFFF",
      "stroke": "#D7DEE8"
    }
  ],
  "nodes": [
    {
      "id": "image",
      "group": "system",
      "label": "Page image",
      "type": "data",
      "bounds": {
        "x": 100,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "detect",
      "group": "system",
      "label": "Text detection\nwhere?",
      "type": "agent",
      "bounds": {
        "x": 360,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "regions",
      "group": "system",
      "label": "Text regions",
      "type": "service",
      "bounds": {
        "x": 620,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "recognize",
      "group": "system",
      "label": "Recognition\nwhat?",
      "type": "agent",
      "bounds": {
        "x": 880,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    },
    {
      "id": "output",
      "group": "system",
      "label": "Text + boxes",
      "type": "action",
      "bounds": {
        "x": 1140,
        "y": 270,
        "width": 210,
        "height": 110
      },
      "ports": {
        "in": {
          "side": "left",
          "offset": 0.5
        },
        "out": {
          "side": "right",
          "offset": 0.5
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "image",
        "port": "out"
      },
      "to": {
        "node": "detect",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          310,
          325
        ],
        [
          360,
          325
        ]
      ]
    },
    {
      "id": "e2",
      "from": {
        "node": "detect",
        "port": "out"
      },
      "to": {
        "node": "regions",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          570,
          325
        ],
        [
          620,
          325
        ]
      ]
    },
    {
      "id": "e3",
      "from": {
        "node": "regions",
        "port": "out"
      },
      "to": {
        "node": "recognize",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          830,
          325
        ],
        [
          880,
          325
        ]
      ]
    },
    {
      "id": "e4",
      "from": {
        "node": "recognize",
        "port": "out"
      },
      "to": {
        "node": "output",
        "port": "in"
      },
      "kind": "primary",
      "route": [
        [
          1090,
          325
        ],
        [
          1140,
          325
        ]
      ]
    }
  ],
  "validation": {
    "no_overlaps": true,
    "route_around_nodes": true,
    "min_text_padding": 16,
    "min_connector_clearance": 12,
    "verify_port_attachment": true,
    "verify_contrast": true
  }
}